# Copy to .env.private (git-ignored) and fill in real values:
#   cp .env.example .env.private
#
# Never commit a filled-in copy. Run the container with:
#   docker run --env-file .env.private ...
#
# NOTE: VITE_* variables are NOT in this file. Vite inlines them into the
# frontend bundle at build time, so they are passed as --build-arg instead:
#   docker build \
#     --build-arg VITE_SSO_URL=https://<your-sso-host>/ \
#     --build-arg VITE_SSO_CLIENT_ID=<your-client-id> \
#     -t knowledge-fabric .

# --- Database (required for deployment, optional for local dev) -------------
# Postgres connection string. Holds a password -- treat as a secret.
# Without DATABASE_URL the backend falls back to the JSON development store.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# Set to "true"/"require" when the server enforces TLS.
DATABASE_SSL=
#
# Local development against docker-compose.dev.yml (`pnpm db:up`):
#DATABASE_URL=postgresql://ontology:ontology@127.0.0.1:55432/ontology
#DATABASE_SSL=disable
#
# To use the local example you MUST comment out the two deployment lines above
# (DATABASE_URL= and DATABASE_SSL=) before uncommenting these two -- do not
# leave both pairs active. server/env.ts skips a key that is already defined,
# line by line, so within one file the FIRST occurrence wins, and the empty
# `DATABASE_SSL=` counts as defined and would suppress `disable`.
# The same first-one-wins rule applies across .env, .env.local and
# .env.private, so DATABASE_URL should take effect exactly once overall.

# --- IAM / SSO token exchange ----------------------------------------------
# Backend sends Authorization: Basic base64(IAM_CLIENT_ID:IAM_CLIENT_SECRET)
# to ${SSO_URL}oauth2/token. See docs/ONTOLOGY_STUDIO_STATUS.md.
SSO_URL=https://<your-sso-host>/
SSO_TOKEN_URL=
IAM_CLIENT_ID=<your-client-id>
IAM_CLIENT_SECRET=<secret>

# --- Azure OpenAI chat completions -----------------------------------------
# Active-active pool across independently rate-limited deployments (ADR 0027).
# JSON array; each entry embeds an apiKey, so the whole value is a secret.
AZURE_OPENAI_UPSTREAMS=[{"id":"azure-a","url":"https://<resource-a>/openai/v1/chat/completions","apiKey":"<key-a>","weight":1},{"id":"azure-b","url":"https://<resource-b>/openai/v1/chat/completions","apiKey":"<key-b>","weight":1}]
# Single-upstream fallback, used when AZURE_OPENAI_UPSTREAMS is unset.
AZURE_OPENAI_CHAT_COMPLETIONS_URL=https://<resource>/openai/v1/chat/completions
AZURE_OPENAI_API_KEY=<key>

# --- Vision extraction ------------------------------------------------------
VISION_EXTRACTION_API_KEY=<key>
VISION_EXTRACTION_BASE_URL=https://<resource>/openai/responses?api-version=2025-04-01-preview

# --- Integrations -----------------------------------------------------------
COMPOSIO_API_KEY=<key>
COMPOSIO_CALLBACK_BASE_URL=

# --- Access control ---------------------------------------------------------
# Comma-separated IAM user IDs granted admin rights.
ONTOLOGY_ADMIN_USER_IDS=

# --- Optional overrides -----------------------------------------------------
# The Dockerfile already sets sane defaults for these; override only if needed.
# PORT=8787
# APP_URL=
# A2A_PUBLIC_BASE_URL=
# SUPPORT_REPORT_RECIPIENTS=
# BITBUCKET_API_BASE_URL=https://api.bitbucket.org/2.0
# BITBUCKET_GIT_BASE_URL=https://bitbucket.org
