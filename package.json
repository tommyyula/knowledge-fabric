{
  "name": "wiki-app",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:frontend & pnpm dev:server",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm test:auth && pnpm test:resource-picker && pnpm test:support-reports && pnpm test:support-reports:postgres && pnpm test:azure-pool && pnpm test:chat-failure && pnpm test:video-sop-model-http && pnpm test:operation-store && pnpm test:operation-history-api && pnpm test:operation-history-ui && pnpm test:operation-associated-delete:postgres && pnpm test:operation-store:postgres",
    "test:auth": "node --import tsx --test scripts/auth-token-exchange.test.mts",
    "test:resource-picker": "node --test scripts/resource-picker-bitbucket-loading.test.mjs",
    "test:support-reports": "node --import tsx --test scripts/technical-issue-reports.test.mts",
    "test:support-reports:postgres": "node --import tsx --test scripts/technical-issue-reports-postgres.test.mts",
    "test:azure-pool": "node --import tsx --test scripts/azure-openai-upstream-pool.test.mts",
    "test:chat-failure": "node --import tsx --test scripts/chat-upstream-failure.test.mts",
    "test:operation-store": "node --import tsx --test scripts/operation-run-store.test.mts",
    "test:operation-history-api": "node --import tsx --test scripts/operation-run-history-api.test.mts",
    "test:operation-history-ui": "node --import tsx --test scripts/operation-run-history-ui.test.mts",
    "test:operation-associated-delete:postgres": "node --import tsx --test scripts/operation-run-associated-deletion-postgres.test.mts",
    "test:operation-store:postgres": "node --import tsx --test scripts/operation-run-store-postgres.test.mts",
    "test:video-sop-model-http": "node --import tsx --test scripts/video-sop-model-http.test.mts",
    "dev:frontend": "vite --port 8888",
    "dev:server": "tsx watch --exclude 'data/**' server/index.ts",
    "start:frontend": "node scripts/serve-dist.mjs",
    "start:server": "tsx server/index.ts",
    "smoke:ontology": "node scripts/smoke-ontology.mjs",
    "smoke:ontology:claude": "node scripts/smoke-ontology.mjs --claude",
    "smoke:ontology:claude-edit": "node scripts/smoke-ontology.mjs --claude-edit",
    "smoke:ontology:postgres": "node scripts/smoke-ontology-postgres.mjs",
    "smoke:ontology:iam": "node scripts/smoke-ontology-iam.mjs",
    "smoke:bitbucket-connection": "node scripts/smoke-bitbucket-connection.mjs",
    "smoke:operation-run": "node --import tsx scripts/smoke-operation-run.mts",
    "smoke:operate-live": "node scripts/smoke-operate-live.mjs",
    "smoke:ontology:claude-ingest": "node scripts/smoke-ontology.mjs --claude-ingest",
    "smoke:maintenance-journey": "node scripts/smoke-maintenance-journey.mjs",
    "smoke:external-knowledge-catalog": "node scripts/smoke-external-knowledge-catalog.mjs",
    "smoke:a2a-external-query": "node scripts/smoke-a2a-external-query.mjs",
    "smoke:a2a-attachment-stager": "tsx scripts/smoke-a2a-attachment-stager.mts",
    "smoke:knowledge-sharing": "node scripts/smoke-knowledge-sharing.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@ai-sdk/react": "^4.0.2",
    "@anthropic-ai/claude-agent-sdk": "^0.3.193",
    "@assistant-ui/react": "^0.14.24",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@base-ui/react": "^1.6.0",
    "@composio/claude-agent-sdk": "^0.10.0",
    "@composio/core": "^0.13.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.1",
    "ai": "^7.0.2",
    "axios": "^1.18.1",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "lucide-react": "^1.21.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.0.0"
  }
}
